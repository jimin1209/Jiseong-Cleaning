# ============================================================================
# 지성크리닝 홍보 웹사이트 — 환경변수
# 이 파일을 `.env.local` 로 복사하고 값을 채우세요. (.env.local 은 커밋되지 않습니다)
# ============================================================================

# ── 샘플(더미) 내용 ──────────────────────────────────────────────────────────
# 사업자등록번호 · 인증번호 · 운영시간 · 처리능력 · 요금은 아직 확정되지 않았습니다.
# 기본값(설정 안 함)은 임시값을 채워 완성된 화면으로 보여주고,
# 화면 맨 위에 「검토용 샘플」 경고 배너가 항상 표시됩니다.
#
# 실제 값을 src/lib/sample.ts 에 채운 뒤 아래를 off 로 바꾸면 배너가 사라집니다.
# ⚠️ 배너가 뜬 상태로 운영 배포하지 마세요.
# NEXT_PUBLIC_SAMPLE_CONTENT=off

# ── 사이트 주소 ──────────────────────────────────────────────────────────────
# sitemap.xml · robots.txt · OG 태그 · 구조화 데이터가 이 값을 씁니다.
# 도메인이 확정되면 실제 주소로 바꾸세요. (www 를 붙이지 마세요)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 관리자 페이지 (/admin/inquiries) ─────────────────────────────────────────
# 문의 목록에는 거래처 담당자의 연락처가 들어갑니다. 반드시 설정하세요.
# 두 값이 비어 있으면 /admin 은 503 으로 완전히 막힙니다(기본 비밀번호 없음).
ADMIN_USER=
ADMIN_PASSWORD=

# ── 문의 저장 위치 ───────────────────────────────────────────────────────────
# 비워두면 `.data/inquiries.db` 를 씁니다.
# ⚠️ Vercel·Netlify 같은 서버리스에 배포하면 파일이 유지되지 않습니다.
#    그 환경에서는 src/lib/inquiries.ts 를 PostgreSQL 로 교체하세요.
# INQUIRY_DB_PATH=

# ── 문의 알림 메일 (선택) ────────────────────────────────────────────────────
# 아래 4개(SMTP_HOST, SMTP_USER, SMTP_PASS, INQUIRY_TO)가 모두 채워지면
# 접수 시 담당자에게 메일이 갑니다. 비어 있으면 조용히 건너뛰고 저장만 합니다.
# 회사 메일·네이버·구글 모두 SMTP 를 지원하므로 별도 서비스 가입이 필요 없습니다.
#
#   네이버  : smtp.naver.com       / 587
#   구글    : smtp.gmail.com       / 587  (앱 비밀번호 필요)
#   다음    : smtp.daum.net        / 465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 보내는 주소를 SMTP_USER 와 다르게 하려면 지정 (예: "지성크리닝 <noreply@example.com>")
SMTP_FROM=
# 문의를 받을 주소. 쉼표로 여러 개 가능
INQUIRY_TO=
